# ==========================================
# Discord Bot Configuration (Node.js)
# ==========================================

# Your Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Your Application/Client ID (from Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# Optional: Specific Server ID for instantaneous slash command sync during development.
# If left blank, commands will sync globally.
GUILD_ID=
