{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Discord Bot (Node.js)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/index.js",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Deploy Slash Commands (Node.js)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/deploy-commands.js",
      "console": "integratedTerminal"
    }
  ]
}
